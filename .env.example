# Copy to .env and fill in the values: cp .env.example .env
# .env is read by docker compose and by the application (spring.config.import) and is never committed.

# PostgreSQL (docker compose and the application)
DB_USER=ottos
DB_PASSWORD=

# JWT signing key, at least 32 bytes: openssl rand -base64 32
OTTOS_JWT_SECRET=

# First administrator, created on startup if none exists
OTTOS_ADMIN_EMAIL=admin@ottos.local
OTTOS_ADMIN_PASSWORD=
